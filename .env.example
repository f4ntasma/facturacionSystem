# Copia este archivo a .env y cambia TODO lo que diga "cambia".
DB_NAME=altoque
DB_USER=altoque
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-por-una-clave-larga-de-al-menos-32-caracteres
# Cifra la clave SOL y la del certificado. No la cambies después de emitir: dejarías de poder leerlas.
APP_CRYPTO_KEY=cambia-por-otra-clave-larga

FRONTEND_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:8081
PUERTO_WEB=8081

# Negocio demo (demo@altoque.pe / altoque123). Ponlo en false en producción.
ALTOQUE_DEMO=true

# Opcionales
APIPERU_TOKEN=
MP_ACCESS_TOKEN=
